{
  "name": "@printee-network/logo-raster",
  "version": "0.1.0",
  "description": "Il logo caricato da chi personalizza un prodotto diventa il PNG dell'anteprima: raster, SVG, PDF e AI, con lo sfondo bianco disegnato che si può togliere. Solo browser.",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "bin": {
    "copia-worker-pdf": "./bin/copia-worker-pdf.mjs"
  },
  "files": [
    "build",
    "bin"
  ],
  "scripts": {
    "build": "rimraf ./build && tsc",
    "prepare": "npm run build",
    "test": "jest"
  },
  "license": "ISC",
